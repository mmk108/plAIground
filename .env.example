# Default is "mock": free, offline, no account. It is a simple rule-based stand-in,
# not a real AI, so you can run every lesson. Switch to a real model when you're ready.
PROVIDER=mock

# If PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# If PROVIDER=github (free tier, needs a GitHub token with models access)
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini
